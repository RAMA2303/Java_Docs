import java.util.concurrent.*;

public class CompletableFutureExample {

    public static void main(String[] args) {

        // 1. Create your own executor
        ExecutorService executor = new ThreadPoolExecutor(
                2,                      // corePoolSize
                5,                      // maxPoolSize
                60,                     // keepAlive
                TimeUnit.SECONDS,
                new ArrayBlockingQueue<>(10),
                new ThreadPoolExecutor.CallerRunsPolicy()
        );

        try {

            // 2. Use custom executor
            CompletableFuture<String> future =
                    CompletableFuture.supplyAsync(() -> {

                        System.out.println(
                                "Running task1 on: "
                                + Thread.currentThread().getName()
                        );

                        sleep(1000);

                        return "Order Details";

                    }, executor);

            // 3. Continue processing on SAME custom executor
            CompletableFuture<String> result =
                    future.thenApplyAsync(order -> {

                        System.out.println(
                                "Running task2 on: "
                                + Thread.currentThread().getName()
                        );

                        return order + " + Payment Details";

                    }, executor);

            // 4. Another async stage on SAME custom executor
            CompletableFuture<String> finalResult =
                    result.thenApplyAsync(data -> {

                        System.out.println(
                                "Running task3 on: "
                                + Thread.currentThread().getName()
                        );

                        return data + " + Customer Details";

                    }, executor);

            System.out.println("Result = " + finalResult.join());

        } finally {
            executor.shutdown();
        }
    }

    static void sleep(long millis) {
        try {
            Thread.sleep(millis);
        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
        }
    }
}
