//2nd Highest Salary by DENSE_RANK
SELECT *
FROM (
    SELECT e.*,
           DENSE_RANK() OVER (ORDER BY salary DESC) AS rnk
    FROM employee e
) x
WHERE rnk = 2;


//Delete Duplicates

DELETE FROM employee
WHERE id IN (
    SELECT id
    FROM (
        SELECT id,
               ROW_NUMBER() OVER (
                   PARTITION BY email
                   ORDER BY id
               ) AS rn
        FROM employee
    ) x
    WHERE rn > 1
);
